{
  "name": "hunkyard",
  "version": "0.1.1",
  "description": "A replacement for GitHub PR review, with local-repo support",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "bun run build:client && bun run build:binary",
    "build:client": "bun run --bun vite build",
    "build:binary": "bun build --compile --minify --sourcemap --bytecode --asset=dist/client bin/hunk.ts --outfile dist/hunk",
    "build:release": "bun run build:client && bun scripts/release.ts",
    "start": "bun run bin/hunk.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@pierre/diffs": "1.3.5",
    "@pierre/icons": "0.7.1",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "private": true,
  "overrides": {
    "shiki": "4.4.3",
    "@shikijs/transformers": "4.4.3",
    "@pierre/theming": "1.0.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
