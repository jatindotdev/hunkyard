{
  "name": "hunkyard",
  "version": "0.0.0",
  "description": "A replacement for GitHub PR review, with local-repo support",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hunk": "bin/hunk.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit --pretty"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@pierre/diffs": "1.3.5",
    "@pierre/icons": "0.7.1",
    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "files": [
    "dist",
    "bin",
    "public",
    "README.md",
    "LICENSE.md"
  ]
}
